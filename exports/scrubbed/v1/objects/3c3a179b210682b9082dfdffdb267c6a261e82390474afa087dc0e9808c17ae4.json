oqge9742jEe66RO6E_FZLM"},"genres":["action-and-adventure"],"languages":["en"],"media":{"duration":20794,"fileSize":336344863},"narrators":["Emma Swan"]},"slug":"3qV5Di_5DsT1zMFl089Fv","title":"Cruise Ship Kid: Thief at Sea!","userId":"yoto","cardId":"fPVaK","createdAt":"2026-02-19T09:51:12.072Z","updatedAt":"2026-10-08T21:40:05.579Z","clubAvailability":[],"sortkey":"3qV5Di_5DsT1zMFl089Fv"},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":false,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":true,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false,"inCardPacks":false,"previewAccessOnly":false}}