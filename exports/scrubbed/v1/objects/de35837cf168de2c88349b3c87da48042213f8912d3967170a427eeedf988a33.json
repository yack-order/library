ge":9,"minAge":7,"abridged":false,"audioPreviewUrl":"https://audio-previews-media.api.yotoplay.com/audio-previews/c2ac1595563a9857899a22457c1b13c0c963f359d4e88e8fb99f3d76def24d80/KZdTW10KyaBOjrThDr3NZcUzwMFnyJCkzgB3tlznx7k.mp3","author":"Xiaobing Wang","accents":["UK English"],"authors":["Xiaobing Wang"],"copyrights":["©2024 Xiaobing Wang ℗2024 DK Audio"],"cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/n_Vq7akWksqs8cEI3fBS4kiGj2xnk2wGK-YY8lAXDUI"},"genres":["learning-and-education"],"languages":["en"],"media":{"duration":8829,"fileSize":142789125,"hasStreams":false},"narrators":["Windson Liong"],"status":{"name":"complete","updatedAt":"2025-02-17T12:36:24.990Z"}},"cardId":"6tdbp","createdAt":"2024-09-19T11:02:55.974Z","updatedAt":"2026-10-13T09:24:30.543Z"},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":false,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":false,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false,"inCardPacks":false,"previewAccessOnly":true}}