w-TZosdjhBpDmXXqsnPLrLR1j8Wi_K6qmV4","display":{"icon16x16":"https://card-content.yotoplay.com/yoto/R-60m21dr9Al8KQCy79k7lScYFRBBCvyYRbIZSDN_0Y"}}]}]},"createdAt":"2019-12-04T00:14:44.141Z","metadata":{"description":"Have a blast in the past! Story lovers will head back in time with adventurer Otto – and super-smart raven, Missy – to the time of the dinosaurs in this ‘roarsome’ quest. Kids will learn all about the dinosaurs and other ancient creatures – thanks to Otto’s ‘dinatron’ gadget – during this epic time-travelling tour. Get ready for a history lesson like no other! Just remember, you’re on their turf – and in their time – now…\n\nLadybird Audio Adventures is an original series for 4-to 7-year-olds; a new, entertaining and engaging way for children to learn about the world around them. These are special stories written exclusively for audio with fun sound and musical effects, perfect for listening at home, before bed and on long journeys.","category":"stories","author":"Ladybird","previewAudio":"https://cdn.shopify.com/s/files/1/0051/8845/2401/files/ladybird-audio-adventures-dinosaur-times.mp3","seriestitle":"Ladybird Audio Adventures Volume 1","seriesorder":"5","abridged":false,"accent":"UK English","audioPreviewUrl":"https://audio-previews-media.api.yotoplay.com/audio-previews/c2ac1595563a9857899a22457c1b13c0c963f359d4e88e8fb99f3d76def24d80/sbQob-xfPQJFb-Ns-yL9iR-IGWR5nrnb6qtA4lXbiD0.mp3","copyright":"© 2019 Ladybird ℗ 2019 Penguin Books Ltd","maxAge":7,"minAge":5,"cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/g6B34DZPkGWi0HZNhKlYZ9d-_SzOenXFyZImsq4Qfpk"},"languages":["en"],"status":{"name":"live","updatedAt":"2020-10-27T12:54:01.796Z"},"media":{"duration":3410,"fileSize":42532221,"hasStreams":false},"accents":["UK English"],"authors":["Ladybird"],"copyrights":["© 2019 Ladybird ℗ 2019 Penguin Books Ltd"],"genres":["learning-and-education","action-and-adventure"],"narrators":["Ben Bailey Smith","Kristen Atherton"]},"slug":"ladybird-audio-adven