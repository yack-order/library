}}]}]},"metadata":{"abridged":false,"author":"Yoto","category":"music","description":"Flutter into a  world where four fairy friends (Goldie, Ruby, Benny and Blossom) live, dance and look out for one another among the flowers. From the dreamy sing-along of “The Magic Garden” to “Goldie Learns to Fly”, “Ruby The Brave” and the wiggle-and-spin of “The Fairy Dance”, this magical collection sprinkles eight original songs with kindness, courage and a little pixie dust. Perfect for imaginative play, gentle wind-downs and dancing round the living room.\n\n\nLovingly crafted in sunny Los Angeles by singer and guitarist Isla June and producer and writer Trent Bower. This creative duo took their love of classic and modern folk tunes and fused it into a rich and imaginative story world. Beautiful music that both kids and big kids will adore.\n\nThis card also includes an extra-special finale: an instrumental lullaby track, perfect for nap times or drifting off to sleep at night.\n\n","maxAge":12,"minAge":0,"narrators":[],"accents":["US English"],"authors":["Yoto"],"copyrights":["© ℗ 2026 Yoto Ltd."],"cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/3Eiq-21JLPv2sf85DwDU0VEIhDe7R5casMVXxI0oGH0"},"languages":["en"],"media":{"duration":3914,"fileSize":63303177,"hasStreams":false},"status":{"name":"new","updatedAt":"2025-06-25T13:53:17.563Z"}},"slug":"fairy-folk","title":"Fairy Folk","userId":"yoto","sortkey":"fairy-folk","clubAvailability":[{"store":"uk"},{"store":"us"},{"store":"ca"},{"store":"eu"},{"store":"au"}],"cardId":"3g3m7","createdAt":"2025-06-25T13:53:33.845Z","updatedAt":"2026-05-12T13:24:22.063Z"},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":false,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":true,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":true,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false,"inCardPacks":false,"previewAccessOnly":false}}