tadata":{"author":"Asia Citro","category":"stories","description":"Follow the adventures of Zoey and her cat Sassafras with this collection of cards 1–6 in the series. With magical animals, science, mystery, and adventure—the Zoey and Sassafras series has something for everyone! Each story features a new magical animal with a problem that must be solved using science. There isn’t a set formula for each book; Zoey sometimes needs to run experiments, while other times she needs to investigate a mystery, and yet other times she needs to do research. Zoey models how to keep a science journal through her handwritten entries in each story. Each story is complete with a glossary of the kid-friendly definitions for scientific terms used. The series highlights child-led inquiry science, and the topics covered align with both Common Core and Next Generation Science Standards.","audioPreviewUrl":"https://audio-previews-media.api.yotoplay.com/audio-previews/6cf89344938084f1b92219093d02902dd188ec2aaf672f74a5a482d7c8844d80/p5CoTiHBE7XQr1cY2gmz5EfeEQcqTlSXx4YNaaItAGw.mp3","seriesorder":3,"seriestitle":"The Zoey and Sassafras Collection","cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/AoCprWOAVoFVrzHixtS0Weu8uo2x4FZtUfr4M5GLQ2E"},"languages":["en"],"media":{"duration":3951,"fileSize":64059071,"hasStreams":false},"status":{"name":"live","updatedAt":"2022-12-16T10:46:23.921Z"}},"cardId":"7fiqv","createdAt":"2022-04-26T09:44:56.686Z","updatedAt":"2026-03-05T09:34:19.487Z","clubAvailability":[]},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":false,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":false,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false,"inCardPacks":false,"previewAccessOnly":true}}