x16":"https://card-content.yotoplay.com/yoto/jmpBDOfiG-5QDXND7NMAy9COAy1QJbM3AofqCy_BYX4"}}]}]},"metadata":{"feedUrl":"https://feeds.captivate.fm/armchairadventures/","lastBuildDate":"2023-04-05T08:37:58.000Z","category":"podcast","description":"I'm on the lookout for some curious, brave and silly explorers to join me on an adventure!\nHey! I’m Connie Chief Adventurer here at Armchair Adventures Travel Agency - where we specialise in journeys of the imagination.\n\nIt's a super fun and a little bit bonkers, join-in story podcast for kids aged 6 to 10.\n\nJoin me and my gang of explorers for a new adventure in every episode. You’ll visit magical places, meet extraordinary people and learn a thing or two along the way.\n\nIt’s packed full of sing and move-along fun. It's perfect for playtime, those gloomy rainy days, boring car journeys, and with your gran!\n\nNew episodes are released twice a month, on the 1st and 3rd Thursdays.\n\nBest Kids and Family Podcast  - Bronze - British Podcast Awards 2022\n\nProduced by Made By Mortals | http://MadebyMortals.org | @MadebyMortals\n\nThis podcast may contain ads. Yoto does not control these ads and they do not represent us or our opinions. Please listen with care.","author":"Made By Mortals","imageUrl":"https://artwork.captivate.fm/694ad613-7d86-4655-a698-d2f3bfc15a38/hnVCD6qtVcC7Q9zYIc_7z6bq.jpg","previewAudio":"","cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/Dm6o4_6FhDlurNMbMU85yl8hx_geXqYsLzf4uP6awwA"},"media":{"duration":0,"fileSize":0},"languages":["en"],"status":{"name":"live","updatedAt":"2023-04-05T14:11:55.637Z"}},"cardId":"8vq9s","createdAt":"2023-04-05T14:14:33.996Z","updatedAt":"2026-10-22T05:45:34.182Z","clubAvailability":[],"lastCheckedAt":"2026-11-01T00:23:34.116Z"},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":true,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":false,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isSha