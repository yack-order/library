":null,"display":{"icon16x16":"https://card-content.yotoplay.com/yoto/jmpBDOfiG-5QDXND7NMAy9COAy1QJbM3AofqCy_BYX4"},"tracks":[{"duration":100,"overlayLabel":"JUL-08","format":"mp3","title":"Introducing Yoga Kids Adventure - Coming July 16th!","type":"stream","trackUrl":"https://traffic.megaphone.fm/ARML7279268791.mp3?updated=1712699395","key":"ea6ed3c666e097d389be","ambient":null,"display":{"icon16x16":"https://card-content.yotoplay.com/yoto/jmpBDOfiG-5QDXND7NMAy9COAy1QJbM3AofqCy_BYX4"}}]}]},"metadata":{"feedUrl":"https://anchor.fm/s/6224bec4/podcast/rss","lastBuildDate":"2024-03-26T13:16:14.000Z","category":"podcast","description":"Yoga Kids Adventure is a kids’ yoga podcast for stretching your body and imagination. Come with us and step into your next yoga adventure! All you need is your ears, your imagination, and a safe place to move. Host and kids’ yoga teacher Kathryn invites young yogis to join her on creative journeys through movement – no screens needed. Stretch out with a morning swim at the beach, or calm your body before bedtime in a cozy bear cave. Wiggle with wild animals on a safari or lift off from your chair as you breathe and bend among the stars. Return to these routines as many times as you want, and do them anywhere that you want! This podcast brings free family yoga to you in your living room, classroom, and even outdoors without being tied to a screen. Yoga Kids Adventure is centered around mindfulness, imaginative play, and physical activity. With audio yoga adventure stories ranging from 5 to 15 minutes, it’s a way to make kids’ yoga part of your every day.\n\n","author":"Tumble Media","imageUrl":"https://d3t3ozftmdmh3i.cloudfront.net/production/podcast_uploaded_nologo/16365753/16365753-1625605873378-6cc180b96332f.jpg","previewAudio":"https://cdn.shopify.com/s/files/1/0051/8845/2401/files/undefined.mp3","cover":{"imageL":"https://card-content.yotoplay.com/1yZaK3MqE6IZfXfNILO4sYgdM9WYYILcUkyoLAtrnaOeO5jmiSlthHkA1GC19kUCw/pub/_QCRpRXgtxMn58vkP