"type":"audio","displayOverlay":"","duration":33,"fileSize":176850,"channels":"mono","display":null,"ambient":null,"overlayLabel":"14","overlayLabelOverride":"14","events":{}}]}]},"metadata":{"category":"stories","description":"A young cub is snatched from his family and home by a giant eagle, then dropped, injured and alone, in a suburban garden. This is where he meets his first Human, and begins his long journey to becoming the most famous dingo in the world. He will never see his mountain home again, or his family. But it is his destiny to save alpine dingoes from extinction, and he dreams of a time when all cubs like him can live in the wild in safety, instead of facing poison and bullets and hatred.  \n\nA children's literary classic in-the-making from one of Australia's most-loved authors","author":"Favel Parrett","abridged":false,"accent":"AU English","copyright":"© Favel Parrett 2021 ℗ Hachette Australia","maxAge":10,"minAge":6,"media":{"duration":3916,"fileSize":22448943,"hasStreams":false},"cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/f5mho7kK1YerBLuHA8BIaw93VFUrB0FjIrDQn7tHO-g"},"languages":["en"],"status":{"name":"complete","updatedAt":"2025-12-15T13:09:12.562Z"},"accents":["AU English"],"authors":["Favel Parrett"],"copyrights":["© Favel Parrett 2021 ℗ Hachette Australia"],"genres":["animal-stories"],"narrators":["Marta Dusseldorp"]},"title":"Wandi","userId":"yoto","cardId":"brcn8","createdAt":"2025-06-12T15:40:00.986Z","updatedAt":"2025-12-15T13:13:30.255Z","clubAvailability":[],"sortkey":"wandi"},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":false,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":false,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false,"inCardPacks":false,"previewAccessOnly":true}}