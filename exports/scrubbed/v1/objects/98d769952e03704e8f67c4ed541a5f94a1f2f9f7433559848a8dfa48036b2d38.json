nals wriggle out of their grasp?","audioPreviewURL":"https://audio-previews-media.api.yotoplay.com/cards/gZ7fy/PreviewInvestigators-1.mp3","abridged":false,"accent":"UK English","audioPreviewUrl":"https://audio-previews-media.api.yotoplay.com/cards/gZ7fy/PreviewInvestigators-1.mp3","copyright":"Text copyright © John Patrick Green 2020, Sound recording copyright © Macmillan Audio 2024","cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/0O18-R3Bpq35NDSAtags0T5H-a8Jarm4gFFfJI1qKBQ"},"languages":["en"],"status":{"name":"complete","updatedAt":"2025-03-25T10:21:23.200Z"},"accents":["UK English"],"authors":["John Patrick Green"],"copyrights":["Text copyright © John Patrick Green 2020, Sound recording copyright © Macmillan Audio 2024"],"genres":["action-and-adventure","funny-stories"],"narrators":["John Patrick Green","Aaron Yamawaki","Christopher Hastings","Helen Laser","Lipica Shah","Max Meyers","Torian Brackett"]}}}