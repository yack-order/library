ize":5637108,"format":"opus","key":"122","overlayLabel":"22-DEC","overlayLabelOverride":"22-DEC","title":"22 décembre","type":"audio","display":null,"ambient":null,"events":{}}]},{"duration":750,"fileSize":5704703,"key":"7Wk-Q79gbgU23gDk5h-z","overlayLabel":"23-DEC","overlayLabelOverride":"23-DEC","title":"23 décembre","hasStreams":false,"availableFrom":null,"ambient":null,"display":{"icon16x16":"https://card-content.yotoplay.com/yoto/CeqIlMLIoHG4h-aK4lWqxFHRYfJJsBLUDgVmCJe83DA"},"tracks":[{"channels":"stereo","duration":750,"fileSize":5704703,"format":"opus","key":"123","overlayLabel":"23-DEC","overlayLabelOverride":"23-DEC","title":"23 décembre","type":"audio","display":null,"ambient":null,"events":{}}]},{"duration":563,"fileSize":4660380,"key":"IH4DM13v6kUwSH293L8e","overlayLabel":"24-DEC","overlayLabelOverride":"24-DEC","title":"24 décembre","hasStreams":false,"availableFrom":null,"ambient":null,"display":{"icon16x16":"https://card-content.yotoplay.com/yoto/MZRywR2RjuD7ejrkymVifHGmcvkVmdTDsP0MCsdnymw"},"tracks":[{"channels":"stereo","duration":563,"fileSize":4660380,"format":"opus","key":"124","overlayLabel":"24-DEC","overlayLabelOverride":"24-DEC","title":"24 décembre","type":"audio","display":null,"ambient":null,"events":{}}]},{"duration":37,"fileSize":308644,"key":"TLw7PQ8y38QB2uH_nOL5","overlayLabel":"25-DEC","overlayLabelOverride":"25-DEC","title":"Crédits","hasStreams":false,"availableFrom":null,"ambient":null,"display":{"icon16x16":"https://card-content.yotoplay.com/yoto/HiFYwmS5MHJPIxGR7SdywamFatI7W6gFLcRgPZbJwE4"},"tracks":[{"channels":"stereo","duration":37,"fileSize":308644,"format":"opus","key":"sHUkMo7kzYg9wrKwk-Xe","overlayLabel":"25-DEC","overlayLabelOverride":"25-DEC","title":"Crédits","type":"audio","display":null,"ambient":null,"events":{}}]}]},"metadata":{"accent":"EU French","author":"Yoto","category":"stories","copyright":"© ℗ 2025 Yoto Ltd. Produit par Blynd.","description":"S'il y a bien un ours qui adore Noël, c'est l'ours Milo. Le 1er décembre, en sortant ses boîtes pleines de guirlandes et de boules de Noël, Milo découvre un objet qui ne fait pas partie de sa collection de décorations : une magnifique clochette parfaitement ronde, brillante, et dorée. À qui ce grelot peut-il bien appartenir ? \n\nOh non ! Milo comprend tout de suite que c’est une clochette magique du Père Noël lui-même, et que sans ce grelot, le traîneau du Père Noël ne pourra pas s’envoler, et Noël pourrait être gâché pour tout le monde… Déterminé à sauver sa fête préférée, Milo entreprend le long voyage pour rendre la clochette directement au Père Noël. \n\nEn route vers le Pôle Nord, il rencontre Billie, une lapine intrépide, et fait équipe avec elle pour une aventure inoubliable. Au fil de l’une route semée d’embûches, les deux amis vont croiser une galerie de personnages tendres et loufoques, et découvrir la joie de différentes traditions des fêtes de fin d’année. \n\nRejoignez Milo et Billie pour 24 épisodes pleins de rebondissements et de chansons. Insérez cette carte Yoto dans votre lecteur chaque jour du 1er au 24 décembre pour découvrir une grande histoire festive et musicale, pleine de rebondissements et de découvertes.\n","maxAge":10,"minAge":3,"abridged":false,"narrators":[],"accents":["EU French"],"authors":["Yoto"],"copyrights":["© ℗ 2025 Yoto Ltd. Produit par Blynd."],"cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/OkHor4uFLwRpjCfaOuyyRpPpvTrh7ZcBZ88stvFSLWk"},"genres":["holidays-and-celebrations"],"languages":["fr"],"media":{"duration":13136,"fileSize":104489521,"hasStreams":false},"status":{"name":"complete","updatedAt":"2025-12-29T09:40:49.782Z"}},"title":"Milo et la cloche magique","userId":"yoto","cardId":"fOYA2","createdAt":"2025-08-14T14:59:17.051Z","updatedAt":"2026-10-08T13:15:04.774Z","clubAvailability":[{"store":"uk"},{"store":"us"},{"store":"ca"},{"store":"eu"},{"store":"au"}],"sortkey":"milo-et-la-cloche-magique"},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":false,"cardI