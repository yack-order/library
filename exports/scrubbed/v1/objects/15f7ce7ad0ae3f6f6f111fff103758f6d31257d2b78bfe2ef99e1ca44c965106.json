endship and family.\n\nThis podcast contains ads. Yoto does not control these ads and they do not represent us or our opinions. Please listen with care.","author":"Wondery","imageUrl":"https://content.production.cdn.art19.com/images/0a/a6/19/cf/0aa619cf-f2d9-4fcf-9e81-ce53a23a93ab/0883087f8219b1a4c4cce2622fc34577cf10136eb2e8679d224750fc31dc764efbd7e0bab276803f48938e40ec3b359cc45c2909cbcd50297cdae04775ba350e.jpeg","note":"Free Version","cover":{"imageL":"https://card-content.yotoplay.com/1yZaK3MqE6IZfXfNILO4sYgdM9WYYILcUkyoLAtrnaOeO5jmiSlthHkA1GC19kUCw/pub/ObYNcFFaQr0vU-X2BUcORdUX1FRpTfUWSBtprX0VhXQ"},"media":{"duration":49445,"fileSize":0},"languages":["en"],"status":{"name":"archived","updatedAt":"2026-01-02T12:47:36.395Z"}},"cardId":"aOP3U","createdAt":"2023-07-06T09:28:01.715Z","updatedAt":"2026-10-29T11:07:33.938Z","lastCheckedAt":"2026-10-31T23:17:33.690Z","clubAvailability":[]},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":true,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":false,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false,"inCardPacks":false,"previewAccessOnly":true}}