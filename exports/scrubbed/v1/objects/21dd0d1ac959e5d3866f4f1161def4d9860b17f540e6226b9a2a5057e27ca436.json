e season.","audioPreviewUrl":"https://audio-previews-media.api.yotoplay.com/audio-previews/d99801c1fc11628666c7977db3ed701d2fa04bf205279a84e8a86b37bca86047/W0uXMdiYKBJyDpTi1Kpe0mtRMosqcmVKystJqsm8ygA.mp3","abridged":false,"accent":"UK English","copyright":"© ℗ 2016 Alison and Michael Battle","cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/zM6RSIWmZFklv1U1KF-HMrVW5Yqcd_S09POdCN5nFOA"},"languages":["en"],"status":{"name":"complete","updatedAt":"2025-10-27T09:59:59.193Z"},"accents":["UK English"],"authors":["Lapland"],"copyrights":["© ℗ 2016 Alison and Michael Battle"],"genres":["holidays-and-celebrations"]}}}