ssibly endure this miserable story. \n\nWith all due respect, \nLemony Snicket","audioPreviewUrl":"https://audio-previews-media.api.yotoplay.com/audio-previews/6cf89344938084f1b92219093d02902dd188ec2aaf672f74a5a482d7c8844d80/79E7r3vAmyUs5sv0KFQAUM4vT9Hjfb-wIhuUcaz4Aww.mp3","seriesorder":3,"seriestitle":"The Trouble Begins: A Collection of Unfortunate Events","readBys":[],"copyrights":[],"accents":[],"cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/f-6J0IULXENMmvpayS8WnRN0EAGxPkl2L8U4iuq-DzY"},"languages":["en"],"media":{"duration":11168,"fileSize":181036572,"hasStreams":false},"status":{"name":"live","updatedAt":"2022-06-16T15:08:35.974Z"},"authors":["Lemony Snicket"]},"cardId":"jdUlf","createdAt":"2022-04-22T14:58:07.918Z","updatedAt":"2026-03-11T15:28:45.336Z","clubAvailability":[]},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":false,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":false,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false,"inCardPacks":false,"previewAccessOnly":true}}