":2174,"format":"mp3","key":"f0223fac7a74b12949a6","overlayLabel":"MAY-01","title":"Wild and Wonderful","trackUrl":"https://www.buzzsprout.com/2298626/episodes/14986831-wild-and-wonderful.mp3","type":"stream","ambient":null,"display":{"icon16x16":"https://card-content.yotoplay.com/yoto/jmpBDOfiG-5QDXND7NMAy9COAy1QJbM3AofqCy_BYX4"}}]},{"duration":3204,"key":"a492fac8867bd2bf81e0","overlayLabel":"MAR-30","title":"UFO Tofu","ambient":null,"display":{"icon16x16":"https://card-content.yotoplay.com/yoto/jmpBDOfiG-5QDXND7NMAy9COAy1QJbM3AofqCy_BYX4"},"tracks":[{"duration":3204,"format":"mp3","key":"a492fac8867bd2bf81e0","overlayLabel":"MAR-30","title":"UFO Tofu","trackUrl":"https://www.buzzsprout.com/2298626/episodes/14747703-ufo-tofu.mp3","type":"stream","ambient":null,"display":{"icon16x16":"https://card-content.yotoplay.com/yoto/jmpBDOfiG-5QDXND7NMAy9COAy1QJbM3AofqCy_BYX4"}}]},{"duration":2260,"key":"06e559c5727613fc4597","overlayLabel":"MAR-01","title":"Beneath the Surface","ambient":null,"display":{"icon16x16":"https://card-content.yotoplay.com/yoto/jmpBDOfiG-5QDXND7NMAy9COAy1QJbM3AofqCy_BYX4"},"tracks":[{"duration":2260,"format":"mp3","key":"06e559c5727613fc4597","overlayLabel":"MAR-01","title":"Beneath the Surface","trackUrl":"https://www.buzzsprout.com/2298626/episodes/14628746-beneath-the-surface.mp3","type":"stream","ambient":null,"display":{"icon16x16":"https://card-content.yotoplay.com/yoto/jmpBDOfiG-5QDXND7NMAy9COAy1QJbM3AofqCy_BYX4"}}]}]},"metadata":{"category":"podcast","description":"Wild Interest is the podcast made by kids for kids. The series is committed to exploring children’s inherent curiosity and providing a space for active listening that touches the heart and fuels the imagination. Sibling creators Nichole and Evan and their crew of contributors invite listeners to learn about the beauty and mystery of the world from a child’s point of view, covering science, fun facts, natural mysteries, and more — episodes are as eclectic and wondrous as your child's mind! In addition to on-the-ground reporting, kids host engaging one-on-one interviews with amazing guests from Grammy award-winning composers to star NFL quarterbacks to groundbreaking scientists. Segments like Grandparent Stories invite young listeners to share inspiring conversations that span generations. In My Favorite Sound, kids from all over the world share field recordings of sounds they love. Jokes, riddles, and other hijinks are woven into every episode. Rooted in the essential human tradition of storytelling, Wild Interest is a celebration of the wisdom, curiosity, and creativity of children. Listen on your next car ride and enjoy the magic that happens when kids are inspired by other kids. It’s wild!","author":"Wild Interest","lastBuildDate":"2025-08-07T17:47:43.000Z","imageUrl":"https://storage.buzzsprout.com/9zqazzvkcz4hqh9oeelvg7xtxzf3?.jpg","feedUrl":"https://feeds.buzzsprout.com/2298626.rss","cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/4tbbQbTUDw1D1_5sPcxKPs7-H6u3aphoT89eV6bKhWo"},"media":{"duration":37435}},"slug":"wild-interest","title":"Wild Interest","userId":"yoto","sortkey":"wild-interest","clubAvailability":[],"cardId":"gZ5mx","createdAt":"2025-08-19T15:20:14.253Z","updatedAt":"2026-10-31T06:30:34.631Z","lastCheckedAt":"2026-11-01T06:34:33.838Z","availability":"free","system":false,"writable":false},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":true,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":false,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false,"inCardPacks":false,"previewAccessOnly":true}}