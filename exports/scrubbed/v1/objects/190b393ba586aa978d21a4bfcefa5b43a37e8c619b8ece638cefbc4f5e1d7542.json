r de 3 ans.    \n\nLa conteuse Cécile Bergame, familière de la scène jeune public, raconte cette histoire à hauteur d’enfant. Elle est accompagnée par Timothée Jolly qui compose des musiques originales peuplées de toy piano, hochets, crécelles, métallophone…","audioPreviewUrl":"https://audio-previews-media.api.yotoplay.com/audio-previews/6cf89344938084f1b92219093d02902dd188ec2aaf672f74a5a482d7c8844d80/ift-lAxxSzgOfH8CU1tPLz-MRXKNOdhDFxl30Svk6U4.mp3","seriestitle":"Collection des Contes de la petite souris","cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/CcEEUbWnEiC5jABwJIsOL2PR3sYu0VcPL-wIeF-MW70"},"languages":["fr"],"media":{"duration":1118,"fileSize":18120627,"hasStreams":false},"status":{"name":"complete","updatedAt":"2024-07-31T09:31:05.352Z"}},"cardId":"f2I0s","createdAt":"2023-09-26T10:36:55.925Z","updatedAt":"2026-03-16T08:04:49.540Z"},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":false,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":false,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false,"inCardPacks":false,"previewAccessOnly":true}}