r listeners.","audioPreviewUrl":"https://audio-previews-media.api.yotoplay.com/audio-previews/6cf89344938084f1b92219093d02902dd188ec2aaf672f74a5a482d7c8844d80/9moG6inEbAbCSHHJVI7gMLVATTYdxnkIHiryAY5-nmw.mp3","cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/Ye8w3Kez_ozDdJ1Fs6LxwcjwaedJ23EqbUvhMTSJ1ME"},"languages":["en"],"media":{"duration":9535,"fileSize":157267096,"hasStreams":false},"status":{"name":"complete","updatedAt":"2021-04-23T08:25:05.948Z"}},"cardId":"1IPVk","createdAt":"2020-11-30T11:00:16.794Z","updatedAt":"2026-03-06T16:55:47.941Z","clubAvailability":[],"sortkey":"the-planets-and-the-solar-system"},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":false,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":false,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false,"inCardPacks":false,"previewAccessOnly":true}}