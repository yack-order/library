nLadybird Audio Adventures is an original series for four-to seven-year-olds; a new, entertaining and engaging way for children to learn about the world around them. These are special stories written exclusively for audio with fun sound and musical effects, perfect for listening at home, before bed and on long journeys. \n\nShortlisted for the Best Children's Audiobook at the New York Festival Radio Awards 2020.","category":"stories","author":"Ladybird","previewAudio":"https://cdn.shopify.com/s/files/1/0051/8845/2401/files/ladybird-audio-adventures-creepy-crawlies.mp3","seriestitle":"Ladybird Audio Adventures - Volume 2","seriesorder":"1","abridged":false,"accent":"UK English","audioPreviewUrl":"https://audio-previews-media.api.yotoplay.com/audio-previews/c2ac1595563a9857899a22457c1b13c0c963f359d4e88e8fb99f3d76def24d80/yb9G-NPkvFFlv3W0BW3MEDAfQjB4a2m15EfwhN6Iih8.mp3","copyright":"© 2020 Ladybird ℗ 2020 Penguin Audio","maxAge":7,"minAge":5,"cover":{"imageL":"https://card-content.yotoplay.com/yoto/pub/9d-4wQAabKKj_iDHWPkFztrXOIfRF5npV54ZTf5EGaI"},"lang":["en"],"status":{"name":"live","updatedAt":"2020-11-24T17:08:44.030Z"},"languages":["en"],"media":{"duration":3992,"fileSize":48854635,"hasStreams":false},"accents":["UK English"],"authors":["Ladybird"],"copyrights":["© 2020 Ladybird ℗ 2020 Penguin Audio"],"genres":["learning-and-education","action-and-adventure"],"narrators":["Sophie Aldred","Kristen Atherton"]},"slug":"ladybird-audio-adventures-creepy-crawlies","title":"Ladybird Audio Adventures - Creepy Crawlies","updatedAt":"2024-06-13T11:32:07.032Z","userId":"yoto","createdAt":"2020-08-13T11:00:32.100Z","sortkey":"ladybird-audio-adventures-creepy-crawlies","clubAvailability":[],"scanToAdd":false},"ownership":{"canAccess":true,"userHasRole":false,"cardIsFree":false,"cardIsMadeByUser":false,"cardIsInFamilyLibrary":false,"cardIsCreatedByFamily":false,"isAccessibleUsingSubscription":false,"isAccessibleAsPhysicalPlay":false,"isShareLink":false,"isReconditionCard":false